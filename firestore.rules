rules_version = '2';

// History Globe — Firestore Security Rules
// 원칙
//  - 학생: 자기 학급 데이터만 읽고, 자기 문서(학생 1명 = 세션당 문서 1개)만 쓴다.
//  - 교사: 자기가 만든 학급·세션·미션만 접근한다.
//  - 관리자: 커스텀 클레임 대신 admins/{uid} 문서 존재 여부로 판별한다(Spark 요금제 → Cloud Functions 없음).
//  - 역사 기본 데이터(polities/figures/places/events/achievement_standards)는 Firestore에 없다(앱 번들 정적 JSON).
//  - 학생 계정은 Firebase Auth 가상 이메일 `{학급인증접두어}-{번호}[-{세대}]@student.local` 을 사용한다.
service cloud.firestore {
  match /databases/{database}/documents {

    // ───────────────────────── 공통 헬퍼 ─────────────────────────
    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }
    function email() { return request.auth.token.email; }

    // 학생 가상 이메일 형식: abc123-7@student.local 또는 abc123-7-2@student.local (비밀번호 초기화 세대)
    // Firebase Auth 는 이메일을 소문자로 정규화하므로 접두어 비교는 항상 lower() 로 한다.
    function isStudentEmail() {
      return signedIn() && email() is string
        && email().matches('^[A-Za-z0-9]{6}-[0-9]{1,3}(-[0-9]{1,3})?@student[.]local$');
    }
    function emailPrefix() { return email().split('-')[0].lower(); }
    function emailNumber() { return int(email().split('@')[0].split('-')[1]); }
    function emailGeneration() {
      return email().split('@')[0].split('-').size() == 3
        ? int(email().split('@')[0].split('-')[2]) : 0;
    }

    function userPath(u) { return /databases/$(database)/documents/users/$(u); }
    function hasProfile() { return signedIn() && exists(userPath(uid())); }
    function me() { return get(userPath(uid())).data; }

    function isAdmin() {
      return signedIn() && exists(/databases/$(database)/documents/admins/$(uid()));
    }
    function isTeacher() { return hasProfile() && me().role == 'teacher'; }
    function isStudent() { return hasProfile() && me().role == 'student' && me().active == true; }
    function myClassId() { return me().classId; }

    function classPath(c) { return /databases/$(database)/documents/classes/$(c); }
    function classData(c) { return get(classPath(c)).data; }
    function classDataAfter(c) { return getAfter(classPath(c)).data; }
    function ownsClass(c) { return isTeacher() && exists(classPath(c)) && classData(c).teacherId == uid(); }
    function inClass(c) { return isStudent() && myClassId() == c; }

    function memberPath(c, n) { return /databases/$(database)/documents/class_members/$(c + '_' + string(n)); }
    // 세션 안의 학생 문서는 uid가 아니라 (학급, 번호)로 식별한다 → 비밀번호 초기화로 uid가 바뀌어도 기록이 유지됨
    function isMember(c, n) {
      return inClass(c) && exists(memberPath(c, n)) && get(memberPath(c, n)).data.uid == uid();
    }

    function sessionData(s) { return get(/databases/$(database)/documents/sessions/$(s)).data; }
    function missionData(m) { return get(/databases/$(database)/documents/missions/$(m)).data; }

    function onlyChanges(keys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(keys);
    }
    function unchanged(keys) {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(keys);
    }

    // ───────────────────────── users ─────────────────────────
    // 교사: { role:'teacher', displayName, schoolLevel, schoolName, subjects[], createdAt }
    // 학생: { role:'student', classId, number, displayName, nickname?, active, createdAt }
    match /users/{userId} {
      allow get: if signedIn() && (
        userId == uid()
        || isAdmin()
        || (isTeacher() && resource.data.role == 'student' && ownsClass(resource.data.classId))
      );
      allow list: if isAdmin()
        || (isTeacher() && resource.data.role == 'student' && ownsClass(resource.data.classId));

      allow create: if signedIn() && userId == uid()
        && request.resource.data.keys().hasAll(['role', 'displayName', 'createdAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30
        && (
          (
            // 교사 가입: 학생 가상 이메일로는 교사 계정을 만들 수 없음
            request.resource.data.role == 'teacher'
            && !isStudentEmail()
            && request.resource.data.keys().hasOnly(['role', 'displayName', 'schoolLevel', 'schoolName', 'subjects', 'createdAt', 'email'])
            && request.resource.data.schoolLevel in ['중학교', '고등학교']
            && request.resource.data.subjects is list
          ) || (
            // 학생 가입: 가상 이메일의 접두어가 해당 학급의 authPrefix와 일치해야 함
            request.resource.data.role == 'student'
            && isStudentEmail()
            && request.resource.data.keys().hasOnly(['role', 'displayName', 'nickname', 'classId', 'number', 'active', 'createdAt'])
            && request.resource.data.active == true
            && request.resource.data.number is int
            && request.resource.data.number == emailNumber()
            && exists(classPath(request.resource.data.classId))
            && classData(request.resource.data.classId).authPrefix.lower() == emailPrefix()
            && classData(request.resource.data.classId).archived == false
          )
        );

      // 본인: 표시 이름·별명·학교 정보만 수정 (role/classId/active/number 변경 불가)
      allow update: if signedIn() && userId == uid()
        && onlyChanges(['displayName', 'nickname', 'schoolLevel', 'schoolName', 'subjects', 'lastSeenAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() >= 1
        && request.resource.data.displayName.size() <= 30;
      // 담당 교사: 학생 비활성화 / 학급 이동 / 이름 정정 (이동 시 원래 학급과 새 학급 모두 본인 소유여야 함)
      allow update: if isTeacher()
        && resource.data.role == 'student'
        && ownsClass(resource.data.classId)
        && onlyChanges(['displayName', 'nickname', 'active', 'classId', 'number'])
        && (request.resource.data.classId == resource.data.classId || ownsClass(request.resource.data.classId));

      allow delete: if isAdmin();
    }

    // ───────────────────────── classes ─────────────────────────
    // { teacherId, name, code, authPrefix, schoolLevel, subject, archived, createdAt, codeUpdatedAt, settings{ walkKmPerDay, sailKmPerDay } }
    // code: 현재 유효한 6자리 학급코드(재발급 가능), authPrefix: 최초 코드(불변, 학생 가상 이메일에 사용)
    match /classes/{classId} {
      allow get: if isAdmin() || ownsClass(classId) || inClass(classId);
      allow list: if isAdmin() || (isTeacher() && resource.data.teacherId == uid());

      allow create: if isTeacher()
        && request.resource.data.teacherId == uid()
        && request.resource.data.code is string
        && request.resource.data.code.matches('^[A-Z0-9]{6}$')
        && request.resource.data.authPrefix == request.resource.data.code
        && request.resource.data.archived == false
        && request.resource.data.name is string
        && request.resource.data.name.size() >= 1
        && request.resource.data.name.size() <= 50;

      allow update: if ownsClass(classId)
        && unchanged(['teacherId', 'authPrefix', 'createdAt'])
        && request.resource.data.code.matches('^[A-Z0-9]{6}$');

      // 삭제 대신 archived=true 로 보관
      allow delete: if false;
    }

    // ───────────────────────── class_codes ─────────────────────────
    // 문서 ID = 학급코드. 학생이 로그인 전에 학급코드로 학급을 찾기 위한 공개 조회 전용 문서.
    // { classId, teacherId, authPrefix, active, resets: { "<번호>": <세대> } }  ← resets 는 비밀번호 초기화된 번호와 세대만 공개(이름 없음)
    match /class_codes/{code} {
      // 문서 ID를 정확히 알아야만 읽을 수 있음(목록 조회 불가) → 코드 자체가 비밀값 역할
      allow get: if true;
      allow list: if isAdmin();

      allow create: if isTeacher()
        && request.resource.data.teacherId == uid()
        && request.resource.data.keys().hasOnly(['classId', 'teacherId', 'authPrefix', 'active', 'resets'])
        && classDataAfter(request.resource.data.classId).teacherId == uid()
        && classDataAfter(request.resource.data.classId).code == code
        && classDataAfter(request.resource.data.classId).authPrefix == request.resource.data.authPrefix;
      allow update: if isTeacher() && resource.data.teacherId == uid()
        && onlyChanges(['active', 'resets']);
      allow delete: if isTeacher() && resource.data.teacherId == uid();
    }

    // ───────────────────────── class_members ─────────────────────────
    // 문서 ID = `${classId}_${number}` → 학급 내 번호 중복 방지
    // { classId, number, uid, displayName, nickname?, active, authGeneration, resetPending, joinedAt, lastSeenAt }
    match /class_members/{memberId} {
      allow get: if isAdmin() || ownsClass(resource.data.classId)
        || (isStudent() && resource.data.uid == uid());
      allow list: if isAdmin() || ownsClass(resource.data.classId);

      // (a) 교사가 명단을 미리 등록 (uid 없이) — 학생은 가입 시 자기 번호 문서를 채움
      allow create: if ownsClass(request.resource.data.classId)
        && memberId == request.resource.data.classId + '_' + string(request.resource.data.number)
        && request.resource.data.number is int
        && (!request.resource.data.keys().hasAny(['uid']) || request.resource.data.uid == null);
      // (b) 학생 자가 등록: 가상 이메일의 접두어·번호가 학급/문서 ID와 일치해야 함
      allow create: if isStudentEmail()
        && memberId == request.resource.data.classId + '_' + string(request.resource.data.number)
        && request.resource.data.keys().hasOnly(['classId', 'number', 'uid', 'displayName', 'nickname', 'active', 'authGeneration', 'resetPending', 'joinedAt', 'lastSeenAt'])
        && request.resource.data.number is int
        && request.resource.data.number == emailNumber()
        && request.resource.data.uid == uid()
        && request.resource.data.active == true
        && request.resource.data.authGeneration == 0
        && emailGeneration() == 0
        && request.resource.data.resetPending == false
        && exists(classPath(request.resource.data.classId))
        && classData(request.resource.data.classId).authPrefix.lower() == emailPrefix()
        && classData(request.resource.data.classId).archived == false;

      // 교사: 비활성화, 이름 정정, 비밀번호 초기화(authGeneration+1, resetPending=true)
      allow update: if ownsClass(resource.data.classId)
        && unchanged(['classId', 'number'])
        && (
          request.resource.data.authGeneration == resource.data.authGeneration
          || (request.resource.data.authGeneration == resource.data.authGeneration + 1
              && request.resource.data.resetPending == true)
        );
      // 학생 본인: 마지막 접속 시각 / 표시 이름만
      allow update: if isStudent() && resource.data.uid == uid()
        && onlyChanges(['lastSeenAt', 'displayName', 'nickname']);
      // 교사가 미리 등록한 자리(uid 없음)를 학생이 최초 가입으로 채움
      allow update: if isStudentEmail() && (!resource.data.keys().hasAny(['uid']) || resource.data.uid == null)
        && resource.data.classId == myClassIdForCreate()
        && resource.data.number == emailNumber()
        && emailGeneration() == resource.data.authGeneration
        && classData(resource.data.classId).authPrefix.lower() == emailPrefix()
        && request.resource.data.uid == uid()
        && request.resource.data.resetPending == false
        && unchanged(['classId', 'number', 'authGeneration', 'active']);
      // 비밀번호 초기화 후 새 세대 계정이 자리를 이어받음 (이전 uid의 기록은 번호 기준이라 유지됨)
      allow update: if isStudentEmail() && resource.data.resetPending == true
        && resource.data.number == emailNumber()
        && emailGeneration() == resource.data.authGeneration
        && classData(resource.data.classId).authPrefix.lower() == emailPrefix()
        && request.resource.data.uid == uid()
        && request.resource.data.resetPending == false
        && unchanged(['classId', 'number', 'authGeneration', 'active']);

      allow delete: if ownsClass(resource.data.classId);
    }
    // 가입 트랜잭션 안에서 users 문서가 아직 없을 수 있으므로 getAfter로 새 프로필의 classId를 읽는다
    function myClassIdForCreate() {
      return getAfter(userPath(uid())).data.classId;
    }

    // ───────────────────────── sessions ─────────────────────────
    // 수업 세션 = 연대 범위 + 표시 레이어 + 강조 국가/인물 + 미션 + 활동지
    // { teacherId, classId, title, status:'draft'|'open'|'closed', yearRange[2], layers{}, highlightPolities[], highlightFigures[],
    //   achievementStandards[], worksheet{}, follow{ enabled, year, camera{lat,lon,zoom}, updatedAt }, createdAt, updatedAt }
    match /sessions/{sessionId} {
      allow get: if isAdmin() || ownsClass(resource.data.classId)
        || (inClass(resource.data.classId) && resource.data.status in ['open', 'closed']);
      allow list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == uid())
        || (inClass(resource.data.classId) && resource.data.status in ['open', 'closed']);

      allow create: if ownsClass(request.resource.data.classId)
        && request.resource.data.teacherId == uid()
        && request.resource.data.status in ['draft', 'open', 'closed']
        && request.resource.data.title is string;
      allow update: if ownsClass(resource.data.classId)
        && unchanged(['teacherId', 'classId', 'createdAt'])
        && request.resource.data.status in ['draft', 'open', 'closed'];
      allow delete: if ownsClass(resource.data.classId);
    }

    // ───────────────────────── student_work ─────────────────────────
    // 학생 1명 = 세션당 문서 1개. 문서 ID = `${sessionId}_${number}`
    // { sessionId, classId, number, uid, pins:[{id,name,lat,lon,year,memo,createdAt}], routes:[{id,title,desc,pinIds[],totalKm}], updatedAt }
    match /student_work/{workId} {
      allow get: if isAdmin() || ownsClass(resource.data.classId)
        || isMember(resource.data.classId, resource.data.number);
      allow list: if isAdmin() || ownsClass(resource.data.classId)
        || isMember(resource.data.classId, resource.data.number);

      allow create: if isMember(request.resource.data.classId, request.resource.data.number)
        && workId == request.resource.data.sessionId + '_' + string(request.resource.data.number)
        && request.resource.data.uid == uid()
        && sessionData(request.resource.data.sessionId).classId == request.resource.data.classId
        && sessionData(request.resource.data.sessionId).status == 'open'
        && request.resource.data.pins is list && request.resource.data.pins.size() <= 200
        && request.resource.data.routes is list && request.resource.data.routes.size() <= 50;
      allow update: if isMember(resource.data.classId, resource.data.number)
        && unchanged(['sessionId', 'classId', 'number'])
        && request.resource.data.uid == uid()
        && sessionData(resource.data.sessionId).status == 'open'
        && request.resource.data.pins is list && request.resource.data.pins.size() <= 200
        && request.resource.data.routes is list && request.resource.data.routes.size() <= 50;
      allow delete: if ownsClass(resource.data.classId);
    }

    // ───────────────────────── missions ─────────────────────────
    // { teacherId, classId, sessionId, title, description, requirements[], published, dueAt, createdAt }
    match /missions/{missionId} {
      allow get: if isAdmin() || ownsClass(resource.data.classId)
        || (inClass(resource.data.classId) && resource.data.published == true);
      allow list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == uid())
        || (inClass(resource.data.classId) && resource.data.published == true);

      allow create: if ownsClass(request.resource.data.classId)
        && request.resource.data.teacherId == uid()
        && request.resource.data.published is bool;
      allow update: if ownsClass(resource.data.classId)
        && unchanged(['teacherId', 'classId', 'createdAt']);
      allow delete: if ownsClass(resource.data.classId);
    }

    // ───────────────────────── submissions ─────────────────────────
    // 문서 ID = `${missionId}_${number}`
    // { missionId, sessionId, classId, number, uid, answers{}, pinIds[], routeIds[], status:'draft'|'submitted', submittedAt, updatedAt }
    match /submissions/{submissionId} {
      allow get: if isAdmin() || ownsClass(resource.data.classId)
        || isMember(resource.data.classId, resource.data.number);
      allow list: if isAdmin() || ownsClass(resource.data.classId)
        || isMember(resource.data.classId, resource.data.number);

      allow create: if isMember(request.resource.data.classId, request.resource.data.number)
        && submissionId == request.resource.data.missionId + '_' + string(request.resource.data.number)
        && request.resource.data.uid == uid()
        && missionData(request.resource.data.missionId).classId == request.resource.data.classId
        && missionData(request.resource.data.missionId).published == true
        && request.resource.data.status in ['draft', 'submitted'];
      allow update: if isMember(resource.data.classId, resource.data.number)
        && unchanged(['missionId', 'classId', 'number', 'sessionId'])
        && request.resource.data.uid == uid()
        && missionData(resource.data.missionId).published == true
        && request.resource.data.status in ['draft', 'submitted'];
      // 교사: 피드백·점수 필드만
      allow update: if ownsClass(resource.data.classId)
        && onlyChanges(['feedback', 'score', 'reviewedAt']);
      allow delete: if ownsClass(resource.data.classId);
    }

    // ───────────────────────── teacher_overrides ─────────────────────────
    // 교사가 자기 학급용으로 추가·수정한 왕조/인물/장소. 기본 데이터(정적 JSON)는 보호되며 여기서만 덮어쓴다.
    // 문서 ID = `${teacherId}_${kind}_${targetId}`  { teacherId, kind:'polity'|'figure'|'place', targetId, op:'add'|'edit'|'hide', data{}, updatedAt }
    match /teacher_overrides/{overrideId} {
      allow get: if isAdmin()
        || (isTeacher() && resource.data.teacherId == uid())
        || (isStudent() && classData(myClassId()).teacherId == resource.data.teacherId);
      allow list: if isAdmin()
        || (isTeacher() && resource.data.teacherId == uid())
        || (isStudent() && classData(myClassId()).teacherId == resource.data.teacherId);

      allow create: if isTeacher()
        && request.resource.data.teacherId == uid()
        && overrideId == uid() + '_' + request.resource.data.kind + '_' + request.resource.data.targetId
        && request.resource.data.kind in ['polity', 'figure', 'place']
        && request.resource.data.op in ['add', 'edit', 'hide'];
      allow update: if isTeacher() && resource.data.teacherId == uid()
        && unchanged(['teacherId', 'kind', 'targetId']);
      allow delete: if isTeacher() && resource.data.teacherId == uid();
    }

    // ───────────────────────── admins ─────────────────────────
    // 최초 관리자는 Firebase 콘솔에서 직접 문서를 만든다(README 참고). { grantedBy, createdAt }
    match /admins/{adminId} {
      allow get: if signedIn() && (adminId == uid() || isAdmin());
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ───────────────────────── data_reviews ─────────────────────────
    // 역사 기본 데이터 검수 상태. 문서 ID = `${kind}_${itemId}`
    // { kind, itemId, status:'pending'|'approved'|'needs_fix', note, reviewerUid, updatedAt, history:[{status,note,reviewerUid,at}] }
    match /data_reviews/{reviewId} {
      allow read: if isAdmin() || isTeacher();
      allow create, update: if isAdmin()
        && request.resource.data.status in ['pending', 'approved', 'needs_fix']
        && request.resource.data.reviewerUid == uid();
      allow delete: if isAdmin();
    }

    // 그 외 모든 경로는 거부
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
