{
  "name": "classroom-tycoon",
  "private": true,
  "version": "0.1.0",
  "description": "동쌤의 교실 국가 타이쿤 — 학급 경제 운영 플랫폼 (Firebase Spark 무료 요금제 전용)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "emulators": "firebase emulators:start --project demo-tycoon",
    "test": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-tycoon \"vitest run --project rules\"",
    "test:all": "npm run test && npm run test:rules",
    "seed": "firebase emulators:exec --only auth,firestore --project demo-tycoon \"tsx scripts/seed-demo.ts\"",
    "prices": "tsx scripts/fetch-prices.ts",
    "deploy": "npm run build && firebase deploy --only hosting,firestore"
  },
  "dependencies": {
    "firebase": "^12.18.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-admin": "^13.6.0",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
