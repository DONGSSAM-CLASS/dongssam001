{
  "name": "imjeong-rpg2",
  "private": true,
  "version": "0.1.0",
  "description": "『임시정부 : 새로운 나라를 향해』 — 대한민국 임시정부의 정부 수립과 운영을 1인칭 3D 로 체험하고, 모은 포인트로 국가유공자께 기부·감사 편지를 쓰는 보훈 역사 RPG (제2탄)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:higgsfield": "node scripts/higgsfield-brief.mjs",
    "deploy": "npm run build && firebase deploy --only hosting",
    "lint": "tsc -b --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
