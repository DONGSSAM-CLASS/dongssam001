# 교사 모드 암호. 이 파일을 .env.local 로 복사한 뒤 값을 바꾸고 다시 빌드하세요.
#
#   cp .env.example .env.local
#   # .env.local 에서 값 수정
#   npm run build
#
# 주의: 백엔드가 없는 앱이라 이 값은 빌드 결과물 안에 그대로 들어갑니다.
# 개발자 도구를 열 줄 아는 사람은 찾아낼 수 있으므로 보안 장치가 아니며,
# 학생 기기에서 정답 화면이 실수로 열리는 것을 막는 가림막입니다.
# 다른 곳에서 쓰는 비밀번호를 재사용하지 마세요.
VITE_TEACHER_PASSCODE=teacher
