# Firebase 웹 앱 설정값 (Firebase 콘솔 > 프로젝트 설정 > 내 앱 > SDK 설정 및 구성)
# 클라이언트 키는 공개되어도 무방하지만, 보안은 전적으로 firestore.rules에 의존합니다.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 로컬 개발 시 Firebase 에뮬레이터(Auth/Firestore) 사용 여부 (true/false)
VITE_USE_EMULATORS=true
VITE_EMULATOR_HOST=127.0.0.1
VITE_AUTH_EMULATOR_PORT=9099
VITE_FIRESTORE_EMULATOR_PORT=8080

# 학생 가상 이메일 도메인 (학생에게 노출되지 않음)
VITE_STUDENT_EMAIL_DOMAIN=student.local
