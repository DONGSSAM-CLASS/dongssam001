{
  "name": "imjeong-rpg",
  "private": true,
  "version": "0.1.0",
  "description": "『임시정부 1919-1945』 — 대한민국 임시정부의 외교·군사 활동을 다룬 아이소메트릭 3D 역사 RPG",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "assets:higgsfield": "node scripts/higgsfield-brief.mjs",
    "deploy": "npm run build && firebase deploy --only hosting",
    "lint": "tsc -b --noEmit",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
