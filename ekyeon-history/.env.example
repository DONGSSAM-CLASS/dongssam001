# Firebase 콘솔 > 프로젝트 설정 > 내 앱(웹) 에서 복사해 .env 파일로 저장하세요.
# 배포·콘솔 작업 계정: dongssam2021@gmail.com
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=ekyeon-history.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=ekyeon-history
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 관리자 2단계 승인 메일 주소
VITE_ADMIN_APPROVER_EMAIL=dongssam94@gmail.com
# 관리자 아이디에 붙는 내부 도메인(실제 메일 주소가 아니어도 됩니다)
VITE_ADMIN_ID_DOMAIN=admin.ekyeon.kr

# App Check(reCAPTCHA v3) 사이트 키 - 비워두면 App Check 비활성화
VITE_RECAPTCHA_SITE_KEY=
# 협업 요청 알림용 Google Apps Script 웹 앱 URL - 비워두면 건너뜁니다
VITE_NOTIFICATION_WEBHOOK_URL=

# 개발 공간 비밀번호
VITE_DEV_SPACE_PASSCODE=2026
# 문의·협업 메일
VITE_CONTACT_EMAIL=dongssam94@gmail.com
# 본원 연구회 / 공식 노션 / 개발 공간 드라이브
