{
  "name": "history-globe",
  "private": true,
  "version": "0.1.0",
  "description": "History Globe — 3D 지구본 기반 세계사 동시대 탐색 웹앱 (2022 개정 교육과정 역사①·세계사·동아시아 역사 기행)",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "typecheck": "tsc -b --noEmit",
    "test": "vitest run --project unit",
    "test:rules": "firebase emulators:exec --only firestore --project demo-history-globe \"vitest run --project rules\"",
    "test:all": "npm run test && npm run test:rules",
    "data:validate": "tsx scripts/validate-data.ts",
    "emulators": "firebase emulators:start --project demo-history-globe",
    "deploy": "npm run build && firebase deploy",
    "seed": "tsx scripts/seed-emulator.ts"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.8",
    "@react-three/fiber": "^9.7.0",
    "firebase": "^12.18.0",
    "html2canvas": "^1.4.1",
    "html2pdf.js": "^0.12.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.3",
    "three": "^0.185.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@types/three": "^0.185.4",
    "@vitejs/plugin-react": "^5.2.0",
    "eslint": "^9.39.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "firebase-tools": "^15.29.0",
    "globals": "^17.12.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^7.3.6",
    "vitest": "^4.1.11"
  }
}
